# ─── FlippIA environment ───────────────────────────────────────────────────────
# Copy to .env and adjust. Never commit .env.

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
# Random 32+ char string. Used to sign session cookies and CSRF tokens.
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Database (PostgreSQL 16 with PostGIS + pgvector). See docker-compose.yml.
DATABASE_URL=postgres://flippia:flippia@localhost:5432/flippia
DATABASE_URL_TEST=postgres://flippia:flippia@localhost:5432/flippia_test
# TLS is required in production unless DATABASE_SSL=false or ?sslmode= is in the URL.
DATABASE_SSL=
# Connections per instance (default 10).
DATABASE_POOL_MAX=

# AI provider. Without a key LIA runs in DETERMINISTIC mode: intent parsing,
# orchestration and every calculation still work; only free-text narrative is
# templated instead of model-generated.
AI_PROVIDER=anthropic            # anthropic | deterministic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_TOKENS=1200
AI_TIMEOUT_MS=15000

# External data sources. Each adapter degrades to a labelled DEMO/UNAVAILABLE
# state when its variable is empty. See docs/DATA_SOURCES.md.
CATASTRO_MODE=demo               # demo | public
URBANISMO_SEVILLA_MODE=demo      # demo | public | official
MARKET_SOURCE_MODE=demo          # demo | partner
FINANCING_PROVIDER_MODE=demo     # demo | partner

# Feature flags (comma separated). See src/modules/core/flags.ts
FEATURE_FLAGS=

# Scheduled jobs: POST /api/cron/watches with "Authorization: Bearer $CRON_SECRET"
# evaluates every organization's watches and purges expired sessions.
CRON_SECRET=

# Observability
LOG_LEVEL=info                   # debug | info | warn | error
OTEL_EXPORTER_OTLP_ENDPOINT=

# Demo. In production either set DEMO_MODE=false or give the demo user a
# private password: the server refuses to start with the example one.
# `pnpm db:seed` in production additionally requires SEED_DEMO=true.
DEMO_MODE=true
DEMO_USER_EMAIL=demo@flippia.local
DEMO_USER_PASSWORD=flippia-demo
# `pnpm db:reset` against a non-local host requires ALLOW_DB_RESET=true.
