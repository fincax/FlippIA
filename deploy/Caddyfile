# HTTPS for FlippIA. DOMAIN comes from .env: the apex domain (flippia.es) or,
# without one, the sslip.io name of the server IP (27-0-174-32.sslip.io).
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000 {
		# SSE streaming of /api/analyze: no buffering, long timeouts.
		flush_interval -1
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
	header {
		-Server
	}
}

# www → apex. Needs a DNS record for www (CNAME to the apex or A to the IP);
# until it exists Caddy simply keeps retrying that certificate.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
