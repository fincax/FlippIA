# ─── FlippIA · producción (docker-compose.prod.yml) ───────────────────────────
# Copia a ./.env en el servidor. deploy/setup-server.sh genera los secretos.

# Dominio público con registro A hacia el servidor (y CNAME www → dominio).
# Sin dominio propio, el nombre sslip.io de la IP también obtiene certificado:
# 27-0-174-32.sslip.io
DOMAIN=flippia.es
APP_URL=https://flippia.es
NODE_ENV=production

# Secretos (openssl rand -base64 48)
APP_SECRET=
POSTGRES_PASSWORD=
CRON_SECRET=

# Base de datos interna del stack (el host "db" es el contenedor de PostGIS).
# Debe llevar la misma contraseña que POSTGRES_PASSWORD.
DATABASE_URL=postgres://flippia:CAMBIA_POR_POSTGRES_PASSWORD@db:5432/flippia
DATABASE_SSL=false
DATABASE_POOL_MAX=6

# Fuentes reales. Catastro e IDE Sevilla son gratuitos y no necesitan clave.
CATASTRO_MODE=public
URBANISMO_SEVILLA_MODE=public
# Comparables y Radar: sin credenciales de Idealista el servidor NO arranca si
# "idealista" está en la lista. Con las claves puestas, cambia a
#   MARKET_SOURCE_MODE=own,idealista,demo  y  RADAR_SOURCES=idealista,demo
# (añade "feeds" solo con RADAR_FEEDS relleno).
MARKET_SOURCE_MODE=own,demo
IDEALISTA_API_KEY=
IDEALISTA_API_SECRET=
RADAR_SOURCES=demo
RADAR_FEEDS=[]
FINANCING_PROVIDER_MODE=demo

# Narrativa con modelo (opcional; sin clave todo funciona en modo determinista)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Demo: desactivada en producción, o activa con contraseña privada.
DEMO_MODE=false
DEMO_USER_EMAIL=demo@flippia.local
DEMO_USER_PASSWORD=

LOG_LEVEL=info
